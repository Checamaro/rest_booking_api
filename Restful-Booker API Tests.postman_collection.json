                  "pm.test(\"Статус код 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Тело содержит обязательные поля\", function () {\n    const jsonData = pm.response.json();\n    pm.expect(jsonData).to.have.keys(\n        'firstname',\n        'lastname',\n        'totalprice',\n        'depositpaid',\n        'bookingdates'\n    );\n});\n\npm.test(\"bookingdates содержит checkin и checkout\", function () {\n    const jsonData = pm.response.json();\n    pm.expect(jsonData.bookingdates).to.have.keys('checkin', 'checkout');\n});"
                ]
              }
            }
