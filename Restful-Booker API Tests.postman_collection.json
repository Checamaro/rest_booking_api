    {
      "name": "02. Booking (POST /booking)",
      "item": [
        {
          "name": "TC 2.1 - Создание нового бронирования",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Статус код 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Тело содержит bookingid и данные booking\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('bookingid');",
                  "    pm.expect(jsonData).to.have.property('booking');",
                  "    pm.expect(jsonData.booking.firstname).to.eql('John');",
                  "    pm.expect(jsonData.booking.bookingdates).to.have.property('checkin');",
                  "});",
                  "pm.environment.set('booking_id', pm.response.json().bookingid);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\": \"John\",\n    \"lastname\": \"Doe\",\n    \"totalprice\": 150,\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"2024-01-01\",\n        \"checkout\": \"2024-01-10\"\n    },\n    \"additionalneeds\": \"Lunch\"\n}"
            },
            "url": {
              "raw": "https://restful-booker.herokuapp.com/booking",
              "protocol": "https",
              "host": [
                "restful-booker",
                "herokuapp",
                "com"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        },
        {
          "name": "TC 2.2 - Негативный: Отсутствует обязательное поле firstname",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус код 500\", function () {\n    pm.expect(pm.response.code).to.be.oneOf([500]);\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"lastname\": \"Doe\",\n    \"totalprice\": 150,\n    \"depositpaid\": true\n}",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            },
            "url": {
              "raw": "https://restful-booker.herokuapp.com/booking",
